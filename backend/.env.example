SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zonumental
SPRING_DATASOURCE_USERNAME=zonumental
SPRING_DATASOURCE_PASSWORD=change-me

# Import du catalogue (tâche ponctuelle). Contact du projet envoyé dans le User-Agent Wikimedia :
# une adresse ou URL propre au projet, jamais une adresse personnelle. A remplacer avant tout import.
ZONUMENTAL_CONTACT=contact-projet@example.org

# Secret de signature des jetons d'accès : base64 d'au moins 32 octets aléatoires
# (ex. `openssl rand -base64 48`). L'appli refuse de démarrer sans lui.
ZONUMENTAL_JWT_SECRET=
# Secret HMAC des clés de limitation de tentatives (RG-009) : base64 d'au moins 32 octets, distinct du JWT.
ZONUMENTAL_HMAC_SECRET=
# Origines supplémentaires autorisées en CORS, séparées par des virgules (vide si même origine).
ZONUMENTAL_CORS_ORIGINES=

# Stockage S3 privé des photos de capture (ADR 0006) : tout fournisseur S3 compatible dans l'UE.
# Le bucket est provisionné hors appli (r0-socle-5) ; l'appli ne le crée jamais.
ZONUMENTAL_S3_ENDPOINT=https://s3.example.eu
ZONUMENTAL_S3_REGION=fr-par
ZONUMENTAL_S3_BUCKET=zonumental-photos
ZONUMENTAL_S3_ACCESS_KEY=
ZONUMENTAL_S3_SECRET_KEY=
